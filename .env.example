DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=aluna_kunsamu
POSTGRES_USER=aluna_kunsamu
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Prefijo público de los archivos servidos (assets de jornada e infografías). En local se deja
# así; en el despliegue la app vive bajo un prefijo que nginx quita antes de pasar la petición,
# y ahí hay que ponerlo completo: MEDIA_URL=/api/aluna-kunsama/media/
MEDIA_URL=/media/

# Presentación HTML de reportes (analitica/presentacion.py) — nunca commitear la key real.
OPENAI_API_KEY=change-me
OPENAI_MODEL=gpt-4o
# Análisis v2 (analitica/v2/). Todas opcionales:
# OPENAI_MODEL_V2=            # modelo solo para v2; si no se define usa OPENAI_MODEL
# KUNSAMU_V2_MAX_OUTPUT_TOKENS=24000
# KUNSAMU_V2_TIMEOUT_SECONDS=540
# KUNSAMU_V2_MAX_CARACTERES_ENTRADA=1200000
# Generación de infografías (analitica/infografia_ia_openai.py) — modelo de imágenes de OpenAI.
OPENAI_IMAGE_MODEL=gpt-image-2
# Tamaño de cada lámina. 2048x1152 = 16:9. Ojo: ambos lados deben ser múltiplos de 16.
OPENAI_IMAGE_SIZE=2048x1152

# --- Solo para el stack de Docker (docker-compose.yml) ---
# Puerto del HOST donde queda publicado gunicorn (127.0.0.1:$APP_PORT) — es lo que un proxy
# externo (nginx, nginx-proxy-manager) debe apuntar. Cambiarlo si ya hay algo corriendo en 8000
# en ese servidor; no afecta el puerto interno del contenedor, que siempre es 8000.
APP_PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# --- Solo para el profile auto-deploy (docker compose --profile auto-deploy up -d) ---
# Ver docs/DOCKER.md antes de activarlo: ese contenedor queda con el socket de Docker del host
# montado (control total sobre TODO Docker en ese servidor, no solo este proyecto).
# Ruta ABSOLUTA de este proyecto en el HOST (no la ruta dentro de un contenedor) — sin default a
# propósito, hay que ponerla explícita para cada servidor donde se active.
HOST_REPO_PATH=/ruta/absoluta/en/el/host/a/este/proyecto
GIT_SYNC_BRANCH=develop
GIT_SYNC_PERIOD_SECONDS=30
