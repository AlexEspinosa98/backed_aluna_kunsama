DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=aluna_kunsamu
POSTGRES_USER=aluna_kunsamu
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Prefijo público de los archivos servidos (assets de jornada e infografías). En local se deja
# así; en el despliegue la app vive bajo un prefijo que nginx quita antes de pasar la petición,
# y ahí hay que ponerlo completo: MEDIA_URL=/api/aluna-kunsama/media/
MEDIA_URL=/media/

# Presentación HTML de reportes (analitica/presentacion.py) — nunca commitear la key real.
OPENAI_API_KEY=change-me
OPENAI_MODEL=gpt-4o
# Generación de infografías (analitica/infografia_ia_openai.py) — modelo de imágenes de OpenAI.
OPENAI_IMAGE_MODEL=gpt-image-2
# Tamaño de cada lámina. 2048x1152 = 16:9. Ojo: ambos lados deben ser múltiplos de 16.
OPENAI_IMAGE_SIZE=2048x1152

# --- Solo para el stack de Docker (docker-compose.yml) ---
# Puerto del HOST donde queda publicado gunicorn (127.0.0.1:$APP_PORT) — es lo que un proxy
# externo (nginx, nginx-proxy-manager) debe apuntar. Cambiarlo si ya hay algo corriendo en 8000
# en ese servidor; no afecta el puerto interno del contenedor, que siempre es 8000.
APP_PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
