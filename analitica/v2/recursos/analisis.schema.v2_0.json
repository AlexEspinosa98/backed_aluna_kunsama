{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kunsamu — Contrato de análisis v2",
  "description": "Salida JSON común a los pipelines llm y bertopic_llm. Todos los campos son obligatorios. La guía añade validaciones semánticas que este esquema no expresa.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "kunsamu.analisis/v2"
      ]
    },
    "pipeline": {
      "type": "string",
      "enum": [
        "llm",
        "bertopic_llm"
      ]
    },
    "estado": {
      "type": "string",
      "enum": [
        "completo",
        "parcial",
        "sin_datos",
        "datos_insuficientes"
      ]
    },
    "alcance": {
      "$ref": "#/$defs/alcance"
    },
    "fuentes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fuente"
      }
    },
    "cobertura": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cobertura"
      }
    },
    "limitaciones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/limitacion"
      }
    },
    "informes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/informe"
      }
    },
    "visualizaciones": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/visual_categorica"
          },
          {
            "$ref": "#/$defs/visual_coordenadas"
          },
          {
            "$ref": "#/$defs/visual_histograma"
          },
          {
            "$ref": "#/$defs/visual_caja"
          },
          {
            "$ref": "#/$defs/visual_calor"
          },
          {
            "$ref": "#/$defs/visual_nube"
          },
          {
            "$ref": "#/$defs/visual_red"
          },
          {
            "$ref": "#/$defs/visual_tabla"
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "pipeline",
    "estado",
    "alcance",
    "fuentes",
    "cobertura",
    "limitaciones",
    "informes",
    "visualizaciones"
